   "source": [
    "import os\n",
    "import sys\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from mpl_toolkits.axes_grid1 import make_axes_locatable\n",
    "from fractions import Fraction\n",
    "\n",
    "# Make sure we can import visualize_mueller from your local lib\n",
    "sys.path.insert(0, \"/Users/chaechae/Desktop/FIU/mmShCola/lib\")\n",
    "from visualization import visualize_mueller\n",
    "\n",
    "# ---------- Utility: inspect NPZ (optional) ----------\n",
    "\n",
    "def print_npz_keys_and_shapes(npz_path):\n",
    "    \"\"\"Print all keys and array shapes inside a .npz file.\"\"\"\n",
    "    data = np.load(npz_path)\n",
    "    print(f\"\\nFile: {npz_path}\")\n",
    "    print(\"-\" * 60)\n",
    "    print(\"Keys and shapes:\\n\")\n",
    "    for key in data.keys():\n",
    "        arr = data[key]\n",
    "        try:\n",
    "            print(f\"{key:20s}  shape={arr.shape}\")\n",
    "        except AttributeError:\n",
    "            print(f\"{key:20s}  (not an array)\")\n",
    "    print(\"-\" * 60)\n",
    "\n",
    "\n",
    "# ---------- Helpers ----------\n",
    "\n",
    "def normalize_to_01(arr):\n",
    "    \"\"\"Normalize array to [0, 1], ignoring NaNs.\"\"\"\n",
    "    arr = np.array(arr, dtype=float)\n",
    "    finite_mask = np.isfinite(arr)\n",
    "    if not np.any(finite_mask):\n",
    "        return np.zeros_like(arr)\n",
    "    vmin = np.min(arr[finite_mask])\n",
    "    vmax = np.max(arr[finite_mask])\n",
    "    if vmax == vmin:\n",
    "        return np.zeros_like(arr)\n",
    "    out = (arr - vmin) / (vmax - vmin)\n",
    "    out[~finite_mask] = 0.0\n",
    "    return out\n",
    "\n",
    "\n",
    "def format_as_pi(x):\n",
    "    \"\"\"\n",
    "    Represent a value (radians) as a multiple of π, e.g. 0, π/6, π/2, 3π/4, etc.\n",
    "    \"\"\"\n",
    "    if not np.isfinite(x):\n",
    "        return \"\"\n",
    "    if abs(x) < 1e-8:\n",
    "        return \"0\"\n",
    "    ratio = x / np.pi\n",
    "    frac = Fraction(ratio).limit_denominator(12)  # up to denominator 12\n",
    "    num = frac.numerator\n",
    "    den = frac.denominator\n",
    "\n",
    "    sign = \"-\" if num < 0 else \"\"\n",
    "    num = abs(num)\n",
    "\n",
    "    if num == 0:\n",
    "        return \"0\"\n",
    "\n",
    "    if den == 1:\n",
    "        core = \"π\" if num == 1 else f\"{num}π\"\n",
    "    else:\n",
    "        if num == 1:\n",
    "            core = f\"π/{den}\"\n",
    "        else:\n",
    "            core = f\"{num}π/{den}\"\n",
    "\n",
    "    return sign + core\n",
    "\n",
    "\n",
    "def pi_tick_label_formatter(vmin, vmax):\n",
    "    \"\"\"Return two tick labels (as strings) in π-notation for [vmin, vmax].\"\"\"\n",
    "    return [format_as_pi(vmin), format_as_pi(vmax)]\n",
    "\n",
    "\n",
    "def save_panel(\n",
    "    arr,\n",
    "    cmap,\n",
    "    out_dir,\n",
    "    base_name,\n",
    "    dpi=600,\n",
    "    fig_size=(3.5, 3),\n",
    "    vmin=None,\n",
    "    vmax=None,\n",
    "    tick_label_func=None,\n",
    "):\n",
    "    \"\"\"\n",
    "    Save a single 2D array as TIFF and PDF with the given colormap.\n",
    "    Includes a colorbar with min/max values in academic journal style.\n",
    "\n",
    "    tick_label_func: optional callable(vmin, vmax) -> [label_min, label_max]\n",
    "                     used e.g. for π-notation labels.\n",
    "    \"\"\"\n",
    "    os.makedirs(out_dir, exist_ok=True)\n",
    "\n",
    "    arr = np.array(arr, dtype=float)\n",
    "    finite_mask = np.isfinite(arr)\n",
    "\n",
    "    # Compute vmin/vmax from finite values if not provided\n",
    "    if vmin is None or vmax is None:\n",
    "        if np.any(finite_mask):\n",
    "            data_vmin = float(np.min(arr[finite_mask]))\n",
    "            data_vmax = float(np.max(arr[finite_mask]))\n",
    "            if data_vmax == data_vmin:\n",
    "                data_vmin, data_vmax = data_vmin - 0.5, data_vmax + 0.5\n",
    "        else:\n",
    "            data_vmin, data_vmax = 0.0, 1.0\n",
    "\n",
    "        vmin = data_vmin if vmin is None else vmin\n",
    "        vmax = data_vmax if vmax is None else vmax\n",
    "\n",
    "    # Publication-style parameters\n",
    "    plt.rcParams.update({\n",
    "        \"figure.dpi\": dpi,\n",
    "        \"font.family\": \"sans-serif\",\n",
    "        \"font.sans-serif\": [\"Arial\"],\n",
    "        \"font.size\": 10,\n",
    "        \"axes.labelsize\": 10,\n",
    "        \"axes.titlesize\": 10,\n",
    "        \"xtick.labelsize\": 9,\n",
    "        \"ytick.labelsize\": 9,\n",
    "    })\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=fig_size)\n",
    "\n",
    "    # Display image\n",
    "    im = ax.imshow(\n",
    "        arr,\n",
    "        cmap=cmap,\n",
    "        vmin=vmin,\n",
    "        vmax=vmax,\n",
    "        origin=\"lower\",\n",
    "        interpolation=\"nearest\",\n",
    "    )\n",
    "    ax.set_axis_off()\n",
    "\n",
    "    # Colorbar\n",
    "    divider = make_axes_locatable(ax)\n",
    "    cax = divider.append_axes(\"right\", size=\"5%\", pad=0.05)\n",
    "    cbar = plt.colorbar(im, cax=cax)\n",
    "    cbar.set_ticks([vmin, vmax])\n",
    "\n",
    "    # Tick labels\n",
    "    if tick_label_func is not None:\n",
    "        labels = tick_label_func(vmin, vmax)\n",
    "        if labels is not None and len(labels) == 2:\n",
    "            cbar.ax.set_yticklabels(labels)\n",
    "    else:\n",
    "        # Always show numeric tick labels with 2 decimal places\n",
    "        cbar.ax.set_yticklabels([f\"{vmin:.2f}\", f\"{vmax:.2f}\"])\n",
    "\n",
    "    cbar.ax.tick_params(labelsize=9, width=0.5, length=3)\n",
    "    cbar.outline.set_linewidth(0.5)\n",
    "\n",
    "    # Save outputs\n",
    "    tiff_path = os.path.join(out_dir, base_name + \".tiff\")\n",
    "    pdf_path = os.path.join(out_dir, base_name + \".pdf\")\n",
    "\n",
    "    fig.savefig(tiff_path, dpi=dpi, bbox_inches=\"tight\", pad_inches=0.02)\n",
    "    fig.savefig(pdf_path, dpi=dpi, bbox_inches=\"tight\", pad_inches=0.02)\n",
    "    plt.close(fig)\n",
    "\n",
    "    print(f\"Saved {base_name} (range: {vmin:.3f} – {vmax:.3f}) ->\")\n",
    "    print(\"  \", tiff_path)\n",
    "    print(\"  \", pdf_path)\n",
    "\n",
    "\n",
    "# ---------- Mueller matrix visualization (keep design, remove labels) ----------\n",
    "\n",
    "def visualize_save_mueller():\n",
    "    \"\"\"\n",
    "    Use the original visualize_mueller design from visualization.py,\n",
    "    but remove all axis labels/ticks and colorbar labels afterwards.\n",
    "    \"\"\"\n",
    "    npz_path = \"/Volumes/ep_ssd/MPL_Data/dani/TRIMMM/Day18/mm_results_D18E_S2A_1/TRIMMM.npz\"\n",
    "    out_dir = \"/Users/chaechae/Desktop/intensity\"\n",
    "    os.makedirs(out_dir, exist_ok=True)\n",
    "\n",
    "    data = np.load(npz_path)\n",
    "    MM = data[\"nM\"]  # shape: (rows, cols, 16)\n",
    "    num_rows, num_cols, n_el = MM.shape\n",
    "    assert n_el == 16, f\"Expected 16 Mueller elements, got {n_el}\"\n",
    "\n",
    "    print(f\"[Mueller] Image shape: {num_rows} x {num_cols}\")\n",
    "    print(f\"[Mueller] Mueller matrix shape: {MM.shape}\")\n",
    "\n",
    "    # Call your original visualization function (keeps layout / design)\n",
    "    visualize_mueller(\n",
    "        data=MM,\n",
    "        visualisation_path=out_dir,\n",
    "        sample_number=\"mueller_matrix\",\n",
    "        wavelength=\"\",\n",
    "        num_rows=num_rows,\n",
    "        num_cols=num_cols,\n",
    "        save_pdf=False,          # we'll save our own \"clean\" version\n",
    "        use_fixed_ranges=True,\n",
    "        use_percentile_ranges=True,\n",
    "    )\n",
    "\n",
    "    # Grab the current figure created by visualize_mueller\n",
    "    fig = plt.gcf()\n",
    "\n",
    "    # Remove all labels, ticks, and axes (including colorbar tick labels)\n",
    "    for ax in fig.get_axes():\n",
    "        ax.set_xlabel(\"\")\n",
    "        ax.set_ylabel(\"\")\n",
    "        ax.set_xticks([])\n",
    "        ax.set_yticks([])\n",
    "        ax.set_xticklabels([])\n",
    "        ax.set_yticklabels([])\n",
    "        ax.set_axis_off()   # hides frame and labels, image remains\n",
    "\n",
    "    clean_tiff = os.path.join(out_dir, \"mueller_matrix_clean.tiff\")\n",
    "    clean_pdf  = os.path.join(out_dir, \"mueller_matrix_clean.pdf\")\n",
    "\n",
    "    fig.savefig(clean_tiff, dpi=600, bbox_inches=\"tight\", pad_inches=0.02)\n",
    "    fig.savefig(clean_pdf,  dpi=600, bbox_inches=\"tight\", pad_inches=0.02)\n",
    "    plt.close(fig)\n",
    "\n",
    "    print(f\"\\nSaved CLEAN Mueller matrix visualization:\\n  {clean_tiff}\\n  {clean_pdf}\\n\")\n",
    "\n",
    "\n",
    "# ---------- Intensity / polarimetry / depol / diattenuation panels ----------\n",
    "\n",
    "def save_intensity_and_polarimetry_panels():\n",
    "    \"\"\"\n",
    "    Save M11s, linrs, Morientations, Mdepols, and Mdiattenuations panels.\n",
    "    - linr and azimuth (Morientation) use π notation for colorbar labels.\n",
    "    \"\"\"\n",
    "    npz_path = \"/Volumes/ep_ssd/MPL_Data/dani/TRIMMM/Day18/mm_results_D18E_S2A_1/TRIMMM.npz\"\n",
    "    out_dir = \"/Users/chaechae/Desktop/intensity\"\n",
    "\n",
    "    data = np.load(npz_path)\n",
    "\n",
    "    # Load arrays\n",
    "    M11s            = data[\"M11s\"]            # (2158, 2558)\n",
    "    Morientations   = data[\"Morientations\"]   # (2158, 2558)\n",
    "    linrs           = data[\"linrs\"]           # (2158, 2558)\n",
    "    Mdepols         = data[\"Mdepols\"]         # (2158, 2558)\n",
    "    Mdiattenuations = data[\"Mdiattenuations\"] # (2158, 2558)\n",
    "\n",
    "    # Normalize M11s to [0,1]\n",
    "    M11_norm = normalize_to_01(M11s)\n",
    "\n",
    "    # Depolarization: clip to [0,1]\n",
    "    Mdepols_clipped = np.clip(Mdepols, 0.0, 1.0)\n",
    "\n",
    "    # Diattenuation: 0 to max(data)\n",
    "    finite_mask_d = np.isfinite(Mdiattenuations)\n",
    "    if np.any(finite_mask_d):\n",
    "        max_diatten = float(np.max(Mdiattenuations[finite_mask_d]))\n",
    "    else:\n",
    "        max_diatten = 1.0  # fallback\n",
    "\n",
    "    # ---- Save M11 ----\n",
    "    save_panel(\n",
    "        M11_norm,\n",
    "        cmap=\"gray\",\n",
    "        out_dir=out_dir,\n",
    "        base_name=\"M11_norm_gray\",\n",
    "    )\n",
    "\n",
    "    # ---- Save linr (linear retardance) with π-notation ticks ----\n",
    "    save_panel(\n",
    "        linrs,\n",
    "        cmap=\"jet\",\n",
    "        out_dir=out_dir,\n",
    "        base_name=\"linrs_jet\",\n",
    "        vmin=0.0,\n",
    "        vmax=np.pi / 6,                  # linear retardance range\n",
    "        tick_label_func=pi_tick_label_formatter,\n",
    "    )\n",
    "\n",
    "    # ---- Save Morientations (azimuth) with π-notation ticks ----\n",
    "    save_panel(\n",
    "        Morientations,\n",
    "        cmap=\"hsv\",\n",
    "        out_dir=out_dir,\n",
    "        base_name=\"Morientations_hsv\",\n",
    "        # vmin/vmax inferred from data, labels in π notation:\n",
    "        tick_label_func=pi_tick_label_formatter,\n",
    "    )\n",
    "\n",
    "    # ---- Save Mdepols: 0–1 (2 decimal places on colorbar) ----\n",
    "    save_panel(\n",
    "        Mdepols_clipped,\n",
    "        cmap=\"jet\",\n",
    "        out_dir=out_dir,\n",
    "        base_name=\"Mdepols_jet_0_1\",\n",
    "        vmin=0.0,\n",
    "        vmax=1.0,\n",
    "    )\n",
    "\n",
    "    # ---- Save Mdiattenuations: 0–max (2 decimal places on colorbar) ----\n",
    "    save_panel(\n",
    "        Mdiattenuations,\n",
    "        cmap=\"jet\",\n",
    "        out_dir=out_dir,\n",
    "        base_name=\"Mdiattenuations_jet_0_max\",\n",
    "        vmin=0.0,\n",
    "        vmax=max_diatten,\n",
    "    )\n",
    "\n",
    "\n",
    "# ---------- Main ----------\n",
    "\n",
    "def main():\n",
    "    # Optional sanity check:\n",
    "    # print_npz_keys_and_shapes(\"/Volumes/ep_ssd/MPL_Data/dani/TRIMMM/Day18/mm_results_D18E_S2A_1/TRIMMM.npz\")\n",
    "\n",
    "    # 1) Save per-parameter panels from TRIMMM file\n",
    "    save_intensity_and_polarimetry_panels()\n",
    "\n",
    "    # 2) Save Mueller matrix visualization (original design, cleaned labels)\n",
    "    visualize_save_mueller()\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()"
   ],
